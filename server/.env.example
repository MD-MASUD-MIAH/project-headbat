# Server Configuration
PORT=5000

# MongoDB Connection URL
# For local MongoDB: mongodb://127.0.0.1:27017/headbat
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/headbat?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/headbat

# JWT Authentication Secret & Token Expiration
JWT_SECRET=headbat_super_secure_jwt_secret_key_2026_xyz
JWT_EXPIRES_IN=7d

# Default Initial Administrator Credentials
ADMIN_NAME=HeadBat Admin
ADMIN_EMAIL=admin@headbat.com
ADMIN_PASSWORD=admin123456
